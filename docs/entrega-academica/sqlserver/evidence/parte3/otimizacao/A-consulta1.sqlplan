<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT n.local_id, p.nome AS provedor, YEAR(n.data_emissao) AS ano, MONTH(n.data_emissao) AS mes,&#xa;           COUNT_BIG(*) AS quantidade_notas, SUM(n.valor_total) AS total_faturado&#xa;    FROM app.Notas AS n&#xa;    JOIN app.Provedores AS p ON p.id = n.provedor_id&#xa;    WHERE n.data_emissao &gt;= DATEADD(MONTH, -12, CONVERT(date, GETDATE()))&#xa;    GROUP BY n.local_id, p.nome, YEAR(n.data_emissao), MONTH(n.data_emissao)&#xa;    ORDER BY ano, mes, n.local_id, provedor&#xa;    OPTION (RECOMPILE)" StatementId="1" StatementCompId="57" StatementType="SELECT" StatementSqlHandle="0x090070E302F6046018FFCB7ECCC17843B3380000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="4" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="2.99795" StatementEstRows="216" SecurityPolicyApplied="true" StatementOptmLevel="FULL" QueryHash="0x02C6D076A188D99B" QueryPlanHash="0x069E5CBEE3F6FC0D" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="3792" CachedPlanSize="120" CompileTime="62" CompileCPU="62" CompileMemory="1224"><MissingIndexes><MissingIndexGroup Impact="79.562"><MissingIndex Database="[SIGpAcademic]" Schema="[app]" Table="[Notas]"><ColumnGroup Usage="INEQUALITY"><Column Name="[data_emissao]" ColumnId="8"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[local_id]" ColumnId="2"></Column><Column Name="[provedor_id]" ColumnId="3"></Column><Column Name="[valor_total]" ColumnId="7"></Column></ColumnGroup></MissingIndex></MissingIndexGroup><