<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT r.local_id, p.nome AS provedor, YEAR(r.data_emissao) AS ano, MONTH(r.data_emissao) AS mes,&#xa;           SUM(r.quantidade) AS quantidade_notas, SUM(r.total) AS total_faturado&#xa;    FROM app.ResumoDiario AS r&#xa;    JOIN app.Provedores AS p ON p.id = r.provedor_id&#xa;    WHERE r.data_emissao &gt;= DATEADD(MONTH, -12, CONVERT(date, GETDATE()))&#xa;    GROUP BY r.local_id, p.nome, YEAR(r.data_emissao), MONTH(r.data_emissao)&#xa;    ORDER BY ano, mes, r.local_id, provedor&#xa;    OPTION (RECOMPILE)" StatementId="1" StatementCompId="53" StatementType="SELECT" StatementSqlHandle="0x09003F2152F35A4DC0245EC45C16BD9200050000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="4" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="0.0676489" StatementEstRows="215.373" SecurityPolicyApplied="true" StatementOptmLevel="FULL" QueryHash="0x1F01200DE77E4472" QueryPlanHash="0xF6C08A0DC926CF2E" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="0" MemoryGrant="1360" NonParallelPlanReason="NonParallelizableIntrinsicFunction" CachedPlanSize="64" CompileTime="26" CompileCPU="26" CompileMemory="1264"><MemoryGrantInfo SerialRequiredMemory="1024" SerialDesiredMemory="1360" RequiredMemory="1024" DesiredMemory="1360" RequestedMemory="1360" GrantWaitTime="0" MaxQueryMemory="251792" GrantedMemory="1360" MaxUsedMemory="128" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvail