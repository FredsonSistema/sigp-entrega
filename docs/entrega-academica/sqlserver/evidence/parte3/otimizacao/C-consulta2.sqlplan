<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT TOP (500) n.id, n.local_id, n.provedor_id, n.valor_total, n.vencimento, n.status&#xa;    FROM app.Notas AS n&#xa;    WHERE n.status = N&apos;PENDENTE&apos;&#xa;      AND n.vencimento &lt; CONVERT(date, GETDATE())&#xa;      AND NOT EXISTS (SELECT 1 FROM app.Conciliacoes AS c WHERE c.nota_id = n.id AND c.status = N&apos;CONCILIADA&apos;)&#xa;    ORDER BY n.vencimento, n.id&#xa;    OPTION (RECOMPILE)" StatementId="2" StatementCompId="59" StatementType="SELECT" StatementSqlHandle="0x0900C9D76181AE687698C1D0E68EFE21BC620000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="4" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="0.205979" StatementEstRows="500" SecurityPolicyApplied="true" StatementOptmLevel="FULL" QueryHash="0x02C605367BCD274D" QueryPlanHash="0xF66EF7C4CC388A02" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" CachedPlanSize="48" CompileTime="10" CompileCPU="10" CompileMemory="792"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="17476" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfParallelism="6" MaxCompileMemory="787576"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-20T17:17:38.33" ModificationCount="0" SamplingPercent="38.7423" Statistics="[UQ_Notas_Chave]" Table="[Notas]" Schema="[app]" Database="[SIGpAcademic]"></StatisticsInf