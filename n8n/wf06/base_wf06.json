    {
      "parameters": {
        "jsCode": "// Agrupa os alertas do dia por situação; sem alertas, encerra sem notificar.\nconst r = $input.first().json.body || {};\nconst itens = r.items || [];\nif (!itens.length) return [];\nconst grupos = {};\nfor (const a of itens) (grupos[a.status] = grupos[a.status] || []).push(a);\nconst nomes = { VENCIDO: 'Vencidos', VENCE_HOJE: 'Vencem hoje', VENCE_EM_BREVE: 'Vencem em breve',\n  DIVERGENCIA: 'Divergências', AGUARDANDO_FATURA: 'Aguardando fatura', FATURA_AUSENTE: 'Fatura não disponível',\n  PAGO_COM_ATRASO: 'Pagas com atraso', PAGO: 'Pagas no prazo',\n  LEITURA_GMAIL_PARADA: 'Leitura do Gmail parada', FATURA_NAO_RECEBIDA: 'Faturas que não chegaram',\n  FATURA_NA_CAIXA: 'Faturas na caixa sem associar' };\nconst ordem = ['LEITURA_GMAIL_PARADA', 'VENCIDO', 'VENCE_HOJE', 'FATURA_NAO_RECEBIDA', 'VENCE_EM_BREVE', 'DIVERGENCIA', 'FATURA_NA_CAIXA', 'PAGO_COM_ATRASO', 'AGUARDANDO_FATURA', 'FATURA_AUSENTE', 'PAGO'];\nconst linhas = [`Alertas SIGp de ${r.hoje} (${itens.length})`];\nfor (const s of ordem) {\n  if (!grupos[s]) continue;\n  linhas.push('', `${nomes[s]} (${grupos[s].length}):`);\n  grupos[s].slice(0, 20).forEach((a) => linhas.push(`- ${a.mensagem}`));\n  if (grupos[s].length > 20) linhas.push(`  … e mais ${grupos[s].length - 20}`);\n}\nconst texto = linhas.join('\\n');\nreturn [{ json: { escopo: 'SIG', titulo: `Alertas do dia ${r.hoje}`, referencia: `alertas-${r.hoje}`, conteudo: texto,\n  texto, assunto: `SIGp · ${itens.length} alerta(s) em ${r.hoje}`, dados: r.resumo || {} } }];"
      },
      "id": "3e2febe0-741b-57b8-9b4e-4a851aea2e87",
