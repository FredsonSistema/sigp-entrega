# Copie para .env.academic (não versionado) e preencha com senhas fortes geradas por você.
# Nenhum valor real fica no repositório.
# Senha do usuário sa do SQL Server acadêmico (mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo).
MSSQL_SA_PASSWORD=
# Chave que o n8n e os testes enviam à API acadêmica da IA (cabeçalho X-API-Key).
SIGP_AI_API_KEY=
# Senhas dos usuários de banco da IA, um por local (só executam as procedures do próprio local).
SIGP_AI_DB_PASSWORD_LOC001=
SIGP_AI_DB_PASSWORD_LOC002=
