<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT n.local_id, p.nome AS provedor, YEAR(n.data_emissao) AS ano, MONTH(n.data_emissao) AS mes,&#xa;           COUNT_BIG(*) AS quantidade_notas, SUM(n.valor_total) AS total_faturado&#xa;    FROM app.Notas AS n&#xa;    JOIN app.Provedores AS p ON p.id = n.provedor_id&#xa;    WHERE n.data_emissao &gt;= DATEADD(MONTH, -12, CONVERT(date, GETDATE()))&#xa;    GROUP BY n.local_id, p.nome, YEAR(n.data_emissao), MONTH(n.data_emissao)&#xa;    ORDER BY ano, mes, n.local_id, provedor&#xa;    OPTION (RECOMPILE)" StatementId="1" StatementCompId="57" StatementType="SELECT" StatementSqlHandle="0x090070E302F6046018FFCB7ECCC17843B3380000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="4" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="1.19887" StatementEstRows="216" SecurityPolicyApplied="true" StatementOptmLevel="FULL" QueryHash="0x02C6D076A188D99B" QueryPlanHash="0x8D514B70BC5CB65F" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="3496" CachedPlanSize="120" CompileTime="18" CompileCPU="18" CompileMemory="952"><MemoryGrantInfo SerialRequiredMemory="3072" SerialDesiredMemory="3496" RequiredMemory="3072" DesiredMemory="3496" RequestedMemory="3496" GrantWaitTime="0" MaxQueryMemory="251776" GrantedMemory="3496" MaxUsedMemory="816" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="17476" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfPara